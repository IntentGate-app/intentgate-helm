# IntentGate starter — copy to .env and fill in.
#   cp .env.example .env
# Generate the three secrets with the commands shown; paste the rest.

# --- what IntentGate gave you with your pilot/license --------------------
INTENTGATE_LICENSE_KEY=        # your Pro license key
INTENTGATE_VERSION=latest      # pin to the release tag IntentGate gave you, e.g. 1.6.2

# --- your environment ----------------------------------------------------
# The tool / MCP server you are putting behind the gateway:
INTENTGATE_UPSTREAM_URL=https://toolserver.your-company.internal:8090
# The gateway URL agents will call from outside this host (external DNS):
INTENTGATE_PUBLIC_GATEWAY_URL=https://gateway.your-company.internal:8080
# The browser URL operators open the console at (must match your proxy/DNS):
CONSOLE_PUBLIC_URL=https://console.your-company.internal
# Only these email domains may be set as an agent owner (comma-separated):
INTENTGATE_OWNER_EMAIL_DOMAINS=your-company.com

# --- secrets — generate, don't invent ------------------------------------
# Postgres password:                 openssl rand -hex 16
POSTGRES_PASSWORD=
# Gateway master key (token signing): openssl rand -hex 32
INTENTGATE_MASTER_KEY=
# Gateway admin token (console->gateway admin API): openssl rand -hex 32
INTENTGATE_ADMIN_TOKEN=
# Console session secret:             openssl rand -hex 32
AUTH_SECRET=
# Field encryption key — must be 64 hex chars: openssl rand -hex 32
INTENTGATE_TOTP_ENCRYPTION_KEY=

# --- single sign-on (your IdP) -------------------------------------------
OIDC_ISSUER=https://login.your-company.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- optional integrations (leave blank to disable) ----------------------
INTENTGATE_POLICY_REQUEST_WEBHOOK_URL=
INTENTGATE_REPORTS_API_TOKEN=
INTENTGATE_DISCOVERY_SYNC_TOKEN=

# --- bind addresses (default 0.0.0.0; set to an internal IP to restrict) -
GATEWAY_BIND=0.0.0.0
CONSOLE_BIND=0.0.0.0

# --- high availability only (docker-compose.ha.yml) ----------------------
# Leave unset for single-host. For HA, point these at your MANAGED services
# and set INTENTGATE_PUBLIC_GATEWAY_URL (above) to your LOAD BALANCER.
# The HA bundle ships a test redis/postgres so you can try it first.
#   Shared budget counters across gateway replicas:
# INTENTGATE_REDIS_URL=redis://your-managed-redis:6379/0
#   Managed PostgreSQL (overrides the bundled one):
# INTENTGATE_POSTGRES_URL=postgres://user:pass@your-managed-pg:5432/intentgate?sslmode=require
